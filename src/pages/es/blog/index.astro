---
import Layout from '../../../layouts/Layout.astro';
import { publishedPosts } from '../../../lib/releases';

const posts = publishedPosts('es');
---

<Layout
	title="Blog | OmniMon"
	description="Notas de release, tutoriales y novedades del proyecto OmniMon."
	lang="es"
>
	<main class="mx-auto flex w-full max-w-4xl flex-col gap-12 px-4 py-10 sm:px-6 lg:px-8 lg:py-14">
		<section class="space-y-6">
			<div>
				<p class="kicker text-sm uppercase tracking-[0.24em]">Blog</p>
				<h1 class="section-title mt-2 text-4xl font-bold sm:text-5xl">Notas de Release y Novedades</h1>
			</div>
			<p class="muted max-w-2xl">Que cambio en cada version de OmniMon, por que importa y donde descargarlo.</p>
		</section>

		<section class="space-y-6">
			{posts.map((post) => (
				<a href={`/es/blog/${post.slug}/`} class="glass-panel block rounded-3xl p-6 transition hover:-translate-y-0.5">
					<div class="flex flex-col gap-2 sm:flex-row sm:items-center sm:justify-between">
						<h2 class="text-xl font-semibold">{post.title}</h2>
						<time class="muted text-sm">{post.date}</time>
					</div>
					<p class="muted mt-3 text-sm leading-7">{post.summary}</p>
				</a>
			))}
		</section>
	</main>
</Layout>
