---
import Layout from '../../layouts/Layout.astro';
import { publishedPosts } from '../../lib/releases';

const posts = publishedPosts('en');
---

<Layout
	title="Blog | OmniMon"
	description="Release notes, tutorials and updates from the OmniMon project."
	lang="en"
>
	<main class="mx-auto flex w-full max-w-4xl flex-col gap-12 px-4 py-10 sm:px-6 lg:px-8 lg:py-14">
		<section class="space-y-6">
			<div>
				<p class="kicker text-sm uppercase tracking-[0.24em]">Blog</p>
				<h1 class="section-title mt-2 text-4xl font-bold sm:text-5xl">Release Notes &amp; Updates</h1>
			</div>
			<p class="muted max-w-2xl">What changed in each version of OmniMon, why it matters, and where to download it.</p>
		</section>

		<section class="space-y-6">
			{posts.map((post) => (
				<a href={`/blog/${post.slug}/`} class="glass-panel block rounded-3xl p-6 transition hover:-translate-y-0.5">
					<div class="flex flex-col gap-2 sm:flex-row sm:items-center sm:justify-between">
						<h2 class="text-xl font-semibold">{post.title}</h2>
						<time class="muted text-sm">{post.date}</time>
					</div>
					<p class="muted mt-3 text-sm leading-7">{post.summary}</p>
				</a>
			))}
		</section>
	</main>
</Layout>
