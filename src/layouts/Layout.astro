---
import '../styles/global.css';
import { OMNIMON_VERSION } from '../consts';
import PostHogInit from '../components/analytics/PostHogInit.astro';
import ThemeToggle from '../components/ThemeToggle.astro';
import CookieBanner from '../components/ui/CookieBanner.astro';
import { legalHref, legalLinkLabel } from '../lib/legal';
import type { ConsentLocale } from '../lib/consent';

interface Props {
	title: string;
	description?: string;
	lang?: ConsentLocale;
}

const {
	title,
	description = `OmniMon ${OMNIMON_VERSION}: observabilidad, seguridad activa y asistentes de IA para macOS, Windows y Linux.`,
	lang = 'es',
} = Astro.props;
const canonicalUrl = Astro.site ? new URL(Astro.url.pathname, Astro.site).toString() : Astro.url.href;
const privacyHref = legalHref(lang, 'privacy');
const termsHref = legalHref(lang, 'terms');

// Huella de build. El workflow de despliegue inyecta PUBLIC_BUILD_SHA con el
// SHA exacto que promociona, y despues vuelve a leer esta etiqueta desde la
// URL publica: si lo servido no coincide, el despliegue falla. Sin la variable
// el valor queda en "dev", asi un build local nunca se confunde con produccion.
const buildSha = import.meta.env.PUBLIC_BUILD_SHA || 'dev';
---

<!doctype html>
<html lang={lang}>
	<head>
		<meta charset="UTF-8" />
		<meta name="description" content={description} />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="theme-color" content="#0b1220" />
		<link rel="canonical" href={canonicalUrl} />

		<!-- Theme bootstrap: applied before paint to avoid flash of wrong theme -->
		<script is:inline>
			(function () {
				try {
					var stored = localStorage.getItem('omnimon-theme');
					// OmniMon current design is dark-only, default to dark unless user explicitly chose light
					var theme = stored === 'light' ? 'light' : 'dark';
					if (theme === 'dark') {
						document.documentElement.classList.add('dark');
					}
				} catch (_) {
					document.documentElement.classList.add('dark');
				}
			})();
		</script>
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" sizes="any" />
		<meta name="generator" content={Astro.generator} />
		<meta name="omnimon-build" content={buildSha} />
		<meta property="og:type" content="website" />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:url" content={canonicalUrl} />
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={description} />
		<title>{title}</title>

		<!-- PostHog Analytics -->
		<PostHogInit />
	</head>
	<body class="bg-slate-950 text-slate-200 font-sans antialiased min-h-screen selection:bg-indigo-500/30 pt-16">
		<nav class="fixed inset-x-0 top-0 z-50 h-16 border-b border-slate-800/80 bg-slate-950/95 backdrop-blur-sm">
			<div class="mx-auto flex h-full max-w-7xl items-center justify-between px-4 sm:px-6 lg:px-8">
				<a href="/" class="text-lg font-bold text-white tracking-tight">OmniMon</a>
				<div class="flex items-center gap-6 text-sm text-slate-300">
					<a href="/blog/" class="transition hover:text-white">Blog</a>
					<a href="https://github.com/chochy2001/omnimon#readme" target="_blank" rel="noreferrer" class="transition hover:text-white">Docs</a>
					<a href="https://github.com/chochy2001/omnimon" target="_blank" rel="noreferrer" class="transition hover:text-white">GitHub</a>
					<a href="https://github.com/chochy2001/omnimon/releases/latest" target="_blank" rel="noreferrer" class="inline-flex items-center rounded-full bg-orange-500 px-4 py-1.5 font-semibold text-slate-950 transition hover:bg-orange-400">Descargar</a>
					<ThemeToggle />
				</div>
			</div>
		</nav>
		<slot />
		<div class="border-t border-slate-800/80 py-4 text-xs text-slate-500">
			<div class="mx-auto flex max-w-7xl flex-wrap items-center gap-3 px-4 sm:px-6 lg:px-8">
				<a href={privacyHref} class="transition hover:text-white">{legalLinkLabel(lang, 'privacy')}</a>
				<span aria-hidden="true">·</span>
				<a href={termsHref} class="transition hover:text-white">{legalLinkLabel(lang, 'terms')}</a>
			</div>
		</div>
		<CookieBanner />
	</body>
</html>
