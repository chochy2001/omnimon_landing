---
// PostHog Analytics. Loaded only after explicit cookie consent.
// LFPDPPP (Mexico) and GDPR (EU) require informed consent before
// any analytics or tracking script fires. This component listens
// for the `omnimon-cookie-consent` event dispatched by CookieBanner
// and also checks localStorage on load for a previously stored
// (non-expired) decision.
const posthogKey = import.meta.env.PUBLIC_POSTHOG_KEY || '';
---

{posthogKey && (
  <script>
    import type { PostHog } from 'posthog-js';
    import {
      COOKIE_CONSENT_EVENT,
      COOKIE_CONSENT_KEY,
      parseConsent,
    } from '../../lib/consent';

    const posthogKey = import.meta.env.PUBLIC_POSTHOG_KEY || '';
    const posthogHost = import.meta.env.PUBLIC_POSTHOG_HOST || 'https://us.i.posthog.com';
    let posthogClient: PostHog | null = null;
    let posthogInitialized = false;

    function consentFromStorage(): boolean {
      try {
        const raw = localStorage.getItem(COOKIE_CONSENT_KEY);
        if (!raw) return false;
        const parsed = parseConsent(raw);
        if (!parsed) {
          localStorage.removeItem(COOKIE_CONSENT_KEY);
          return false;
        }
        return parsed.accepted === true;
      } catch {
        return false;
      }
    }

    async function initPostHog() {
      if (posthogInitialized || !consentFromStorage()) return;
      posthogInitialized = true;
      const { default: posthog } = await import('posthog-js');
      posthog.init(posthogKey, {
        api_host: posthogHost,
        person_profiles: 'identified_only',
        capture_pageview: true,
        capture_pageleave: true,
        autocapture: true,
      });
      posthogClient = posthog;
    }

    window.addEventListener(COOKIE_CONSENT_EVENT, function (event) {
      const detail = event instanceof CustomEvent ? event.detail : null;
      if (detail && detail.accepted === true) {
        void initPostHog();
      } else if (posthogClient) {
        posthogClient.opt_out_capturing();
      }
    });

    void initPostHog();
  </script>
)}
