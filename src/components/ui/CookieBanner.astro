---
/**
 * CookieBanner
 *
 * LFPDPPP (Mexico) and GDPR (EU) compliant consent banner.
 *
 * - Persists decision in localStorage under `omnimon-cookie-consent`.
 * - On accept, dispatches a `omnimon-cookie-consent` event so PostHogInit
 *   (and any other tracker that listens) can fire `posthog.init()`.
 * - On reject, stores `{ accepted: false }` so the banner does not
 *   re-appear for 365 days.
 * - Configure opens an inline preferences panel (essentials always on,
 *   one analytics toggle). Save persists and dispatches the same event.
 * - Bilingual: picks Spanish or English from `document.documentElement.lang`.
 *
 * Style notes:
 * - Solid backgrounds only (no transparencies / no `backdrop-filter`),
 *   per the workspace UI rule. Border + shadow give depth instead.
 * - Follows light/dark tokens from `html.dark`.
 */
---

<div
  id="omnimon-cookie-banner"
  data-omnimon-cookie-banner
  class="cookie-banner fixed inset-x-0 bottom-0 z-[100] hidden"
  role="region"
  aria-label="Aviso de cookies"
  aria-live="polite"
>
  <div class="mx-auto flex max-w-7xl flex-col gap-4 px-4 py-5 sm:px-6 lg:flex-row lg:items-center lg:justify-between lg:gap-8 lg:px-8">
    <div class="muted flex-1 text-sm leading-relaxed">
      <p class="mb-1 font-semibold" style="color: var(--text-main)" data-omnimon-banner-title>
        Cookies y analiticas
      </p>
      <p data-omnimon-banner-body>
        Usamos cookies tecnicas y analiticas (PostHog) para mejorar OmniMon.
        Tu decision se guarda por 365 dias. No vendemos tus datos.
      </p>
      <p class="mt-2 text-sm">
        <a
          data-omnimon-banner-privacy
          href="/es/privacy"
          class="font-medium underline-offset-2 transition hover:underline" style="color: var(--accent)"
        >
          Politica de privacidad
        </a>
        <span class="mx-2 text-slate-600" aria-hidden="true">·</span>
        <a
          data-omnimon-banner-terms
          href="/es/terms"
          class="font-medium underline-offset-2 transition hover:underline" style="color: var(--accent)"
        >
          Terminos
        </a>
        <span class="mx-2 text-slate-600" aria-hidden="true">·</span>
        <a
          data-omnimon-banner-cookies
          href="/es/cookies"
          class="font-medium underline-offset-2 transition hover:underline" style="color: var(--accent)"
        >
          Politica de cookies
        </a>
      </p>
    </div>
    <div class="flex flex-col gap-2 sm:flex-row sm:items-center sm:gap-3">
      <button
        type="button"
        data-omnimon-banner-reject
        class="inline-flex items-center justify-center rounded-full border px-4 py-2 text-sm font-medium transition focus:outline-none focus-visible:ring-2 focus-visible:ring-orange-400" style="border-color: var(--surface-border); background: var(--bg-elevated); color: var(--text-main)"
      >
        Solo esenciales
      </button>
      <button
        type="button"
        data-omnimon-banner-configure
        aria-expanded="false"
        aria-controls="omnimon-cookie-prefs"
        class="inline-flex items-center justify-center rounded-full border px-4 py-2 text-sm font-medium transition focus:outline-none focus-visible:ring-2 focus-visible:ring-orange-400" style="border-color: var(--surface-border); background: var(--bg-elevated); color: var(--text-main)"
      >
        Configurar
      </button>
      <button
        type="button"
        data-omnimon-banner-accept
        class="inline-flex items-center justify-center rounded-full bg-orange-500 px-5 py-2 text-sm font-semibold text-slate-950 transition hover:bg-orange-400 focus:outline-none focus-visible:ring-2 focus-visible:ring-orange-300"
      >
        Aceptar todas
      </button>
    </div>
  </div>
  <div
    id="omnimon-cookie-prefs"
    data-omnimon-cookie-prefs
    class="mx-auto hidden max-w-7xl flex-col gap-3 px-4 pb-5 sm:px-6 lg:px-8"
    role="group"
    aria-label="Preferencias de cookies"
  >
    <p class="text-sm font-semibold" style="color: var(--text-main)" data-omnimon-prefs-title>
      Preferencias de cookies
    </p>
    <p class="muted text-sm" data-omnimon-prefs-necessary>
      Esenciales: siempre activas. Guardan tu eleccion, tema e idioma en este navegador.
    </p>
    <label class="flex cursor-pointer items-start gap-3 text-sm" style="color: var(--text-main)">
      <input
        type="checkbox"
        data-omnimon-prefs-analytics
        class="mt-1 h-4 w-4 shrink-0 accent-orange-500"
      />
      <span data-omnimon-prefs-analytics-label>
        Analitica (PostHog): mide visitas e interacciones. Solo se carga si la activas.
      </span>
    </label>
    <div class="flex flex-col gap-2 sm:flex-row sm:items-center sm:gap-3">
      <button
        type="button"
        data-omnimon-prefs-save
        class="inline-flex items-center justify-center rounded-full bg-orange-500 px-5 py-2 text-sm font-semibold text-slate-950 transition hover:bg-orange-400 focus:outline-none focus-visible:ring-2 focus-visible:ring-orange-300"
      >
        Guardar eleccion
      </button>
      <button
        type="button"
        data-omnimon-prefs-cancel
        class="inline-flex items-center justify-center rounded-full border px-4 py-2 text-sm font-medium transition focus:outline-none focus-visible:ring-2 focus-visible:ring-orange-400" style="border-color: var(--surface-border); background: var(--bg-elevated); color: var(--text-main)"
      >
        Volver
      </button>
    </div>
  </div>
</div>

<script>
  import {
    COOKIE_CONSENT_EVENT,
    COOKIE_CONSENT_KEY,
    buildConsentPayload,
    detectLocale,
    parseConsent,
    resolveBannerStrings,
    serializeConsent,
  } from '../../lib/consent';

  function readStored() {
    try {
      const raw = localStorage.getItem(COOKIE_CONSENT_KEY);
      const parsed = parseConsent(raw);
      if (!parsed && raw) {
        localStorage.removeItem(COOKIE_CONSENT_KEY);
      }
      return parsed;
    } catch {
      return null;
    }
  }

  function persist(accepted: boolean) {
    try {
      localStorage.setItem(COOKIE_CONSENT_KEY, serializeConsent(buildConsentPayload(accepted)));
    } catch {
      // localStorage blocked. Banner will reappear next visit; acceptable.
    }
  }

  function dispatch(accepted: boolean) {
    try {
      window.dispatchEvent(new CustomEvent(COOKIE_CONSENT_EVENT, { detail: { accepted: !!accepted } }));
    } catch {
      // CustomEvent constructor unsupported. Listeners simply will not fire.
    }
  }

  function hide(banner: Element | null) {
    if (!banner) return;
    banner.classList.add('hidden');
    document.body.style.paddingBottom = '';
  }

  function show(banner: Element | null) {
    if (!banner) return;
    banner.classList.remove('hidden');
    const height = banner instanceof HTMLElement ? banner.offsetHeight : 0;
    document.body.style.paddingBottom = height ? `${height}px` : '7rem';
  }

  function applyStrings(banner: Element, locale: 'es' | 'en') {
    const s = resolveBannerStrings(locale);
    banner.setAttribute('aria-label', s.aria);
    const title = banner.querySelector('[data-omnimon-banner-title]');
    const body = banner.querySelector('[data-omnimon-banner-body]');
    const accept = banner.querySelector('[data-omnimon-banner-accept]');
    const reject = banner.querySelector('[data-omnimon-banner-reject]');
    const configure = banner.querySelector('[data-omnimon-banner-configure]');
    const privacy = banner.querySelector('[data-omnimon-banner-privacy]');
    const terms = banner.querySelector('[data-omnimon-banner-terms]');
    const cookies = banner.querySelector('[data-omnimon-banner-cookies]');
    const prefsTitle = banner.querySelector('[data-omnimon-prefs-title]');
    const prefsNecessary = banner.querySelector('[data-omnimon-prefs-necessary]');
    const prefsAnalytics = banner.querySelector('[data-omnimon-prefs-analytics-label]');
    const prefsSave = banner.querySelector('[data-omnimon-prefs-save]');
    const prefsCancel = banner.querySelector('[data-omnimon-prefs-cancel]');
    const prefsGroup = banner.querySelector('[data-omnimon-cookie-prefs]');
    if (title) title.textContent = s.title;
    if (body) body.textContent = s.body;
    if (accept) accept.textContent = s.accept;
    if (reject) reject.textContent = s.reject;
    if (configure) configure.textContent = s.configure;
    if (privacy instanceof HTMLAnchorElement) {
      privacy.textContent = s.privacy;
      privacy.setAttribute('href', s.privacyHref);
    }
    if (terms instanceof HTMLAnchorElement) {
      terms.textContent = s.terms;
      terms.setAttribute('href', s.termsHref);
    }
    if (cookies instanceof HTMLAnchorElement) {
      cookies.textContent = s.cookies;
      cookies.setAttribute('href', s.cookiesHref);
    }
    if (prefsTitle) prefsTitle.textContent = s.prefsTitle;
    if (prefsNecessary) prefsNecessary.textContent = s.prefsNecessary;
    if (prefsAnalytics) prefsAnalytics.textContent = s.prefsAnalytics;
    if (prefsSave) prefsSave.textContent = s.prefsSave;
    if (prefsCancel) prefsCancel.textContent = s.prefsCancel;
    if (prefsGroup) prefsGroup.setAttribute('aria-label', s.prefsTitle);
  }

  function init() {
    const banner = document.querySelector('[data-omnimon-cookie-banner]');
    if (!banner) return;

    applyStrings(banner, detectLocale(document.documentElement.lang));

    const stored = readStored();
    if (stored) {
      hide(banner);
      return;
    }

    show(banner);

    const accept = banner.querySelector('[data-omnimon-banner-accept]');
    const reject = banner.querySelector('[data-omnimon-banner-reject]');
    const configure = banner.querySelector('[data-omnimon-banner-configure]');
    const prefs = banner.querySelector('[data-omnimon-cookie-prefs]');
    const analyticsBox = banner.querySelector('[data-omnimon-prefs-analytics]');
    const prefsSave = banner.querySelector('[data-omnimon-prefs-save]');
    const prefsCancel = banner.querySelector('[data-omnimon-prefs-cancel]');

    function onAccept() {
      persist(true);
      dispatch(true);
      hide(banner);
    }
    function onReject() {
      persist(false);
      dispatch(false);
      hide(banner);
    }

    function setPrefsOpen(open: boolean) {
      if (!prefs) return;
      prefs.classList.toggle('hidden', !open);
      prefs.classList.toggle('flex', open);
      if (configure) configure.setAttribute('aria-expanded', open ? 'true' : 'false');
    }

    if (accept) accept.addEventListener('click', onAccept);
    if (reject) reject.addEventListener('click', onReject);
    if (configure) {
      configure.addEventListener('click', () => {
        const isOpen = prefs ? !prefs.classList.contains('hidden') : false;
        setPrefsOpen(!isOpen);
      });
    }
    if (prefsSave) {
      prefsSave.addEventListener('click', () => {
        const enabled = analyticsBox instanceof HTMLInputElement ? analyticsBox.checked === true : false;
        persist(enabled);
        dispatch(enabled);
        hide(banner);
      });
    }
    if (prefsCancel) {
      prefsCancel.addEventListener('click', () => {
        setPrefsOpen(false);
      });
    }
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', init);
  } else {
    init();
  }
</script>
