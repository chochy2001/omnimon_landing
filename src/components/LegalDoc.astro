---
import Layout from '../layouts/Layout.astro';
import type { ConsentLocale } from '../lib/consent';
import { legalHref, legalLinkLabel, resolveLegalStrings, type LegalPage } from '../lib/legal';

interface Props {
  locale: ConsentLocale;
  page: LegalPage;
}

const { locale, page } = Astro.props;
const copy = resolveLegalStrings(locale);
const title = page === 'privacy' ? copy.privacyTitle : page === 'terms' ? copy.termsTitle : copy.cookiesTitle;
const body = page === 'privacy' ? copy.privacyBody : page === 'terms' ? copy.termsBody : copy.cookiesBody;
const otherPages: LegalPage[] = (['privacy', 'terms', 'cookies'] as LegalPage[]).filter((p) => p !== page);
const otherLocale: ConsentLocale = locale === 'es' ? 'en' : 'es';
---

<Layout title={`${title} | OmniMon`} description={body[0]} lang={locale}>
  <main class="mx-auto flex w-full max-w-3xl flex-col gap-8 px-4 py-10 sm:px-6 lg:px-8 lg:py-14">
    <header class="space-y-3">
      <p class="text-sm text-slate-400">
        <a href={legalHref(otherLocale, page)} class="transition hover:text-sky-300">
          {otherLocale === 'en' ? 'English' : 'Espanol'}
        </a>
      </p>
      <h1 class="section-title text-4xl font-black tracking-tight">{title}</h1>
      <p class="muted text-sm">Actualizado / Updated: {copy.updated}</p>
    </header>
    <article class="muted space-y-4 text-sm leading-7">
      {body.map((paragraph) => (
        <p>{paragraph}</p>
      ))}
    </article>
    <p class="flex flex-wrap gap-x-5 gap-y-2 text-sm text-slate-400">
      {otherPages.map((other) => (
        <a href={legalHref(locale, other)} class="transition hover:text-white">
          {legalLinkLabel(locale, other)}
        </a>
      ))}
    </p>
  </main>
</Layout>
