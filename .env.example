# PostHog Analytics
# Get your project API key from: https://us.posthog.com/settings/project
PUBLIC_POSTHOG_KEY=phc_your_key_here
PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# Hostinger FTPS deploy (landing) — names only, never commit real values.
# In CI these live in GitHub Secrets/Variables (see .github/DEPLOYMENT.md);
# locally they live in .env.local (git-ignored). Placeholders below are not
# credentials and must not be replaced with real values in this file.
HOSTINGER_FTPS_HOST=
FTP_HOST=
FTP_USER=
FTP_PASSWORD=
FTP_PORT=21
FTP_REMOTE_DIR=
