+---
+import Layout from '../layouts/Layout.astro';
+---
+
+<Layout
+	title="Privacy Policy | OmniMon"
+	description="Privacy policy for OmniMon landing analytics, consent, and support data."
+	lang="en"
+>
+	<main class="mx-auto flex w-full max-w-3xl flex-col gap-8 px-4 py-16 sm:px-6 lg:px-8">
+		<a href="/" class="text-sm font-semibold text-orange-300 hover:text-orange-200">Back to OmniMon</a>
+		<section class="glass-panel rounded-3xl p-6 sm:p-8">
+			<p class="text-sm uppercase tracking-[0.24em] text-sky-200">Privacy</p>
+			<h1 class="mt-3 text-4xl font-black tracking-tight text-white">Privacy Policy</h1>
+			<p class="mt-4 text-slate-300">Last updated: June 28, 2026.</p>
+			<div class="mt-8 space-y-6 text-slate-300">
+				<p>OmniMon uses essential site storage and optional PostHog analytics only after explicit consent. Analytics help understand aggregate usage of the landing page and documentation links.</p>
+				<p>When analytics are accepted, the browser may send page views, interaction events, approximate technical metadata, and consent state to PostHog. OmniMon does not sell personal data.</p>
+				<p>You can reject analytics from the cookie banner. The decision is stored in localStorage for up to 365 days under `omnimon-cookie-consent`.</p>
+				<p>For privacy questions, contact the project maintainer through the OmniMon GitHub repository.</p>
+			</div>
+		</section>
+	</main>
+</Layout>
