diff --git a/.github/workflows/ci.yml b/.github/workflows/ci.yml
new file mode 100644
index 0000000..0669215
--- /dev/null
+++ b/.github/workflows/ci.yml
@@ -0,0 +1,63 @@
+name: CI
+
+on:
+  pull_request:
+    branches: [main]
+    paths:
+      - '.github/workflows/ci.yml'
+      - '.deploy/**'
+      - 'astro.config.mjs'
+      - 'bun.lock'
+      - 'package.json'
+      - 'playwright.config.ts'
+      - 'public/**'
+      - 'scripts/**'
+      - 'src/**'
+      - 'tests/**'
+      - 'tsconfig.json'
+  push:
+    branches: [main]
+    paths:
+      - '.github/workflows/ci.yml'
+      - '.deploy/**'
+      - 'astro.config.mjs'
+      - 'bun.lock'
+      - 'package.json'
+      - 'playwright.config.ts'
+      - 'public/**'
+      - 'scripts/**'
+      - 'src/**'
+      - 'tests/**'
+      - 'tsconfig.json'
+
+permissions:
+  contents: read
+
+env:
+  FORCE_JAVASCRIPT_ACTIONS_TO_NODE24: true
+
+concurrency:
+  group: omnimon-landing-ci-${{ github.ref }}
+  cancel-in-progress: true
+
+jobs:
+  build:
+    name: Astro build
+    runs-on: ubuntu-latest
+    timeout-minutes: 10
+    steps:
+      - uses: actions/checkout@34e114876b0b11c390a56381ad16ebd13914f8d5
+      - name: Setup Bun
+        uses: oven-sh/setup-bun@0c5077e51419868618aeaa5fe8019c62421857d6
+        with:
+          bun-version: 1.3.9
+      - name: Install deps
+        run: bun install --frozen-lockfile
+      - name: Lint
+        run: bun run lint
+      - name: Build
+        run: bun run build
+      - name: Install Playwright browser
+        run: bunx playwright install chromium
+      - name: Test consent, CSP, and generated locale guardrails
+        run: bun run test
