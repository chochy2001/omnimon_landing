diff --git a/scripts/validate-blog-artifact.mjs b/scripts/validate-blog-artifact.mjs
new file mode 100644
index 0000000..369a2e8
--- /dev/null
+++ b/scripts/validate-blog-artifact.mjs
@@ -0,0 +1,47 @@
+import { existsSync, readFileSync } from 'node:fs';
+import path from 'node:path';
+
+const checks = [
+  {
+    html: 'dist/blog/index.html',
+    distBase: 'dist/blog',
+    legacyBase: '.deploy/site_work/blog',
+    hrefPattern: /href="\/blog\/([^"/]+)\/"/g,
+  },
+  {
+    html: 'dist/es/blog/index.html',
+    distBase: 'dist/es/blog',
+    legacyBase: '.deploy/site_work/es/blog',
+    hrefPattern: /href="\/es\/blog\/([^"/]+)\/"/g,
+  },
+];
+
+let failures = 0;
+
+for (const check of checks) {
+  if (!existsSync(check.html)) {
+    console.error(`FAIL Missing built blog index: ${check.html}`);
+    failures += 1;
+    continue;
+  }
+
+  const html = readFileSync(check.html, 'utf8');
+  const slugs = [...html.matchAll(check.hrefPattern)].map((match) => match[1]);
+  const uniqueSlugs = [...new Set(slugs)];
+  const missing = uniqueSlugs.filter((slug) => {
+    const builtTarget = path.join(check.distBase, slug, 'index.html');
+    const legacyTarget = path.join(check.legacyBase, slug, 'index.html');
+    return !existsSync(builtTarget) && !existsSync(legacyTarget);
+  });
+
+  if (missing.length > 0) {
+    console.error(`FAIL ${check.html} links to missing blog targets: ${missing.join(', ')}`);
+    failures += missing.length;
+  } else {
+    console.log(`PASS ${check.html} blog links resolve through dist/ or .deploy/site_work/ (${uniqueSlugs.length} links)`);
+  }
+}
+
+if (failures > 0) {
+  process.exitCode = 1;
+}
diff --git a/scripts/validate-consent-analytics.mjs b/scripts/validate-consent-analytics.mjs
new file mode 100644
index 0000000..fa40d2d
--- /dev/null
+++ b/scripts/validate-consent-analytics.mjs
@@ -0,0 +1,131 @@
+import { readFile } from 'node:fs/promises';
+
+const [posthogInit, cookieBanner, layout] = await Promise.all([
+  readFile('src/components/analytics/PostHogInit.astro', 'utf8'),
+  readFile('src/components/ui/CookieBanner.astro', 'utf8'),
+  readFile('src/layouts/Layout.astro', 'utf8'),
+]);
+
+const posthogInitIndex = posthogInit.indexOf('posthog.init(');
+const consentGuardIndex = posthogInit.indexOf('if (posthogInitialized || !hasAnalyticsConsent()) return;');
+
+const checks = [
+  {
+    name: 'PostHog uses the shared consent storage key',
+    ok: posthogInit.includes("COOKIE_CONSENT_KEY = 'omnimon-cookie-consent'"),
+  },
+  {
+    name: 'PostHog initialization is guarded by explicit analytics consent',
+    ok: consentGuardIndex !== -1 && posthogInitIndex !== -1 && consentGuardIndex < posthogInitIndex,
+  },
+  {
+    name: 'PostHog listens for the consent event before initializing',
+    ok:
+      posthogInit.includes("window.addEventListener('omnimon-cookie-consent'") &&
+      posthogInit.includes('detail.accepted === true'),
+  },
+  {
+    name: 'Cookie banner persists accept and reject decisions',
+    ok:
+      cookieBanner.includes("var KEY = 'omnimon-cookie-consent'") &&
+      cookieBanner.includes('persist(true)') &&
+      cookieBanner.includes('persist(false)'),
+  },
+  {
+    name: 'Cookie banner dispatches consent decisions to analytics listeners',
+    ok:
+      cookieBanner.includes("var EVENT = 'omnimon-cookie-consent'") &&
+      cookieBanner.includes('dispatch(true)') &&
+      cookieBanner.includes('dispatch(false)'),
+  },
+  {
+    name: 'CSP keeps PostHog script/connect hosts conditional on a configured key',
+    ok:
+      layout.includes("const POSTHOG_KEY = import.meta.env.PUBLIC_POSTHOG_KEY || ''") &&
+      layout.includes("script-src 'self' 'unsafe-inline'${POSTHOG_KEY ? ' ' + POSTHOG_ASSET_HOST : ''}") &&
+      layout.includes("connect-src 'self'${POSTHOG_KEY ? ' ' + POSTHOG_HOST : ''}"),
+  },
+  {
+    name: 'Layout renders cookie banner before PostHog listener component',
+    ok: layout.indexOf('<CookieBanner lang={lang} />') !== -1 && layout.indexOf('<CookieBanner lang={lang} />') < layout.indexOf('<PostHogInit />'),
+  },
+  {
+    name: 'Cookie banner receives server-side locale copy before hydration',
+    ok:
+      cookieBanner.includes("const locale = Astro.props.lang === 'en' ? 'en' : 'es'") &&
+      cookieBanner.includes('aria-label={strings.aria}') &&
+      cookieBanner.includes('{strings.title}') &&
+      cookieBanner.includes('{strings.body}') &&
+      cookieBanner.includes('{strings.privacy}'),
+  },
+  {
+    name: 'Cookie banner links to built privacy policy pages',
+    ok:
+      cookieBanner.includes("const privacyHref = locale === 'en' ? '/privacy/' : '/es/privacidad/'") &&
+      cookieBanner.includes('href={privacyHref}') &&
+      layout.includes('<CookieBanner lang={lang} />'),
+  },
+];
+
+const failures = checks.filter((check) => !check.ok);
+
+for (const check of checks) {
+  console.log(`${check.ok ? 'PASS' : 'FAIL'} ${check.name}`);
+}
+
+async function checkBuiltHtml() {
+  try {
+    const [englishBlog, spanishBlog] = await Promise.all([
+      readFile('dist/blog/index.html', 'utf8'),
+      readFile('dist/es/blog/index.html', 'utf8'),
+    ]);
+
+    const generatedChecks = [
+      {
+        name: 'Generated English pages render English cookie banner before hydration',
+        ok:
+          englishBlog.includes('<html lang="en"') &&
+          englishBlog.includes('aria-label="Cookie notice"') &&
+          englishBlog.includes('Cookies and analytics') &&
+          englishBlog.includes('Essential only') &&
+          englishBlog.includes('Accept analytics') &&
+          englishBlog.includes('Accept all') &&
+          englishBlog.includes('href="/privacy/"'),
+      },
+      {
+        name: 'Generated Spanish pages render Spanish cookie banner before hydration',
+        ok:
+          spanishBlog.includes('<html lang="es"') &&
+          spanishBlog.includes('aria-label="Aviso de cookies"') &&
+          spanishBlog.includes('Cookies y analiticas') &&
+          spanishBlog.includes('Solo esenciales') &&
+          spanishBlog.includes('Aceptar analiticas') &&
+          spanishBlog.includes('Aceptar todas') &&
+          spanishBlog.includes('href="/es/privacidad/"'),
+      },
+      {
+        name: 'Generated privacy policy pages exist in both locales',
+        ok:
+          (await readFile('dist/privacy/index.html', 'utf8')).includes('Privacy Policy') &&
+          (await readFile('dist/es/privacidad/index.html', 'utf8')).includes('Politica de privacidad'),
+      },
+    ];
+
+    for (const check of generatedChecks) {
+      console.log(`${check.ok ? 'PASS' : 'FAIL'} ${check.name}`);
+      if (!check.ok) failures.push(check);
+    }
+  } catch (error) {
+    if (error && error.code === 'ENOENT') {
+      console.log('SKIP Generated HTML locale checks because dist/ is not built');
+      return;
+    }
+    throw error;
+  }
+}
+
+await checkBuiltHtml();
+
+if (failures.length > 0) {
+  process.exitCode = 1;
+}
