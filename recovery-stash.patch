--- /dev/null
+++ b/tests/e2e/navigation.spec.ts
@@ -0,0 +1,139 @@
+import { expect, test, type Locator, type Page } from "@playwright/test";
+
+const consentKey = "omnimon-cookie-consent";
+const ignoredConsoleErrors = [
+  "The Content Security Policy directive 'frame-ancestors' is ignored when delivered via a <meta> element.",
+];
+
+type ConsentDetail = { accepted: boolean };
+type ConsentWindow = Window & {
+  __omnimonConsentEvents: ConsentDetail[];
+};
+
+async function installConsoleGuards(page: Page): Promise<string[]> {
+  const errors: string[] = [];
+  page.on("console", (message) => {
+    const text = message.text();
+    if (
+      message.type() === "error" &&
+      !ignoredConsoleErrors.some((ignored) => text.includes(ignored))
+    ) {
+      errors.push(text);
+    }
+  });
+  page.on("pageerror", (error) => {
+    errors.push(error.message);
+  });
+  await page.addInitScript(
+    (storageKey) => {
+      const consentWindow = window as unknown as ConsentWindow;
+      consentWindow.__omnimonConsentEvents = [];
+      localStorage.removeItem(storageKey);
+      window.addEventListener("omnimon-cookie-consent", (event) => {
+        consentWindow.__omnimonConsentEvents.push(
+          (event as CustomEvent<ConsentDetail>).detail,
+        );
+      });
+    },
+    consentKey,
+  );
+  return errors;
+}
+
+async function activateConsentAction(
+  page: Page,
+  banner: Locator,
+  selector: string,
+) {
+  const action = banner.locator(selector);
+  try {
+    await action.click({ timeout: 5_000 });
+  } catch {
+    await action.focus();
+    await page.keyboard.press("Enter");
+  }
+}
+
+test("desktop nav exposes product links and release CTA", async ({ page }) => {
+  await page.goto("/");
+  const nav = page.getByRole("navigation");
+
+  await expect(
+    nav.getByRole("link", { name: "OmniMon", exact: true }),
+  ).toBeVisible();
+  await expect(
+    nav.getByRole("link", { name: "Blog", exact: true }),
+  ).toBeVisible();
+  await expect(
+    nav.getByRole("link", { name: "Docs", exact: true }),
+  ).toBeVisible();
+  await expect(
+    nav.getByRole("link", { name: "GitHub", exact: true }),
+  ).toBeVisible();
+  await expect(nav.locator('a[href*="/releases/latest"]')).toBeVisible();
+});
+
+test("cookie banner reject flow persists essential-only consent", async ({
+  page,
+}) => {
+  const errors = await installConsoleGuards(page);
+  await page.goto("/");
+
+  const banner = page.locator("[data-omnimon-cookie-banner]");
+  await expect(banner).toBeVisible();
+  await activateConsentAction(page, banner, "[data-omnimon-banner-reject]");
+  await expect(banner).toBeHidden();
+
+  const state = await page.evaluate((key) => {
+    const raw = localStorage.getItem(key);
+    return raw ? JSON.parse(raw) : null;
+  }, consentKey);
+  const events = await page.evaluate(
+    () => (window as unknown as ConsentWindow).__omnimonConsentEvents,
+  );
+
+  expect(state?.accepted).toBe(false);
+  expect(state?.version).toBe(1);
+  expect(events).toEqual([{ accepted: false }]);
+  expect(errors).toEqual([]);
+});
+
+test("cookie banner accept flow persists analytics consent", async ({ page }) => {
+  const errors = await installConsoleGuards(page);
+  await page.goto("/");
+
+  const banner = page.locator("[data-omnimon-cookie-banner]");
+  await expect(banner).toBeVisible();
+  await activateConsentAction(page, banner, "[data-omnimon-banner-accept]");
+  await expect(banner).toBeHidden();
+
+  const state = await page.evaluate((key) => {
+    const raw = localStorage.getItem(key);
+    return raw ? JSON.parse(raw) : null;
+  }, consentKey);
+  const events = await page.evaluate(
+    () => (window as unknown as ConsentWindow).__omnimonConsentEvents,
+  );
+
+  expect(state?.accepted).toBe(true);
+  expect(state?.version).toBe(1);
+  expect(events).toEqual([{ accepted: true }]);
+  expect(errors).toEqual([]);
+});
+
+test("mobile nav remains reachable without horizontal overflow", async ({
+  page,
+}) => {
